{
  "manifest_version": 3,
  "name": "Vantage Focus",
  "version": "0.1.0",
  "description": "Timed, locked-down LeetCode and NeetCode sessions with official hints only.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vantage Focus",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "declarativeNetRequest", "identity", "notifications", "offscreen"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://neetcode.io/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://neetcode.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
