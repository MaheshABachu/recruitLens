# Copy to .env.local (gitignored) and fill in. See CLAUDE.md → Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google OAuth Web client ID — the same one set on Supabase's Google provider.
# Turns on Google Identity Services sign-in; unset falls back to the redirect flow.
VITE_GOOGLE_CLIENT_ID=
VITE_BILLING_ENABLED=
VITE_LOGO_DEV_TOKEN=

# Server/script-only — never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOGO_DEV_SECRET_KEY=
RESEND_API_KEY=
